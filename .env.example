# Campus Free Slot Finder Environment Configuration
# Database Configuration (PostgreSQL 18 authoritative database)
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/postgres
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=

# Cache Configuration (Valkey / Redis)
# If Valkey is unavailable, system automatically falls back to PostgreSQL
VALKEY_URL=valkey://127.0.0.1:6379/0
CACHE_ENABLED=true
CACHE_TTL_MIN=25
CACHE_TTL_MAX=35

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SESSION_SECRET_KEY=dev-campus-free-slot-finder-session-secret-key-32-chars-long!
CAMPUS_ID=main-campus-gehu

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Background Worker Settings
WORKER_POLL_INTERVAL_SEC=2.0
WORKER_LEASE_DURATION_SEC=60
MAX_JOB_RETRIES=3
