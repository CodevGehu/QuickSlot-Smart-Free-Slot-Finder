:80 {
    encode gzip zstd

    # Route API traffic to FastAPI backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /health {
        reverse_proxy backend:8000
    }

    # Serve built React frontend single-page application
    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
